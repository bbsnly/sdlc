{
  "version": 1,
  "backlog": { "path": "user_stories.json" },
  "git": { "trunk_branch": "main", "remote": false },
  "commands": {
    "smoke":     "",
    "build":     "",
    "test":      "pytest -q",
    "lint":      "ruff check .",
    "fmt":       "ruff format .",
    "fmt_check": "ruff format --check .",
    "fmt_file":  "case \"$FILE\" in *.py) ruff format \"$FILE\" ;; esac",
    "coverage":  "p=$(mktemp) \u0026\u0026 trap 'rm -f \"$p\"' EXIT \u0026\u0026 COVERAGE_FILE=\"$p\" pytest -q --cov --cov-report=term | grep -E '^TOTAL' | grep -Eo '[0-9]+%' | tr -d %",
    "mutation":  ""
  },
  "thresholds": {
    "coverage_min": 80,
    "mutation_min": 70
  },
  "paths": {
    "tests": {
      "dirs": ["tests/","test/","fixtures/","testdata/"],
      "file_globs": ["test_*.py","*_test.py","conftest.py"]
    },
    "src": ["src/"]
  },
  "spec": { "paths": ["docs/", "spec/", "README.md"] },
  "loop": { "max_review_rounds": 2, "max_rework_rounds": 3, "max_stop_blocks": 3 },
  "reviews": { "gate7_advisory": false },
  "freeze": { "allow_new_test_files": false },
  "human_gates": { "pre_commit_pause_tiers": ["high"], "dor_advocate_check": false },
  "budget": { "per_story_usd": 60, "alert_fractions": [0.5, 0.8, 1.0] }
}
