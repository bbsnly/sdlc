{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/sdlc-hook\" PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/sdlc-hook\" PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/sdlc-hook\" Stop",
            "timeout": 45
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/sdlc-hook\" SessionStart",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "sdlc:approve|sdlc:unfreeze|sdlc:ack|sdlc:remap|sdlc:release|sdlc:assign|sdlc:init|sdlc:doctor|approve|unfreeze|ack|remap|release|assign|init|doctor",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/sdlc-hook\" UserPromptExpansion",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
