#!/bin/sh
# Hand a hook event to the sdlc binary, wherever it happens to live.
#
# This runs on every matching tool call, so it does as little as possible and
# never blocks the session on its own failure: if the binary cannot be found,
# the tool call is allowed and the reason goes to stderr, where Claude Code
# shows it. Enforcement silently off would be worse than enforcement off with
# an explanation.
#
# The fallback path uses only shell builtins. An environment that has lost the
# sdlc binary may have lost more, and the failure path is the last place that
# should need something else to be installed.
set -eu

event="${1:-}"

find_binary() {
  if [ -n "${SDLC_BIN:-}" ] && [ -x "${SDLC_BIN}" ]; then
    printf '%s' "${SDLC_BIN}"
    return 0
  fi
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -x "${CLAUDE_PLUGIN_ROOT}/bin/sdlc" ]; then
    printf '%s' "${CLAUDE_PLUGIN_ROOT}/bin/sdlc"
    return 0
  fi
  if command -v sdlc >/dev/null 2>&1; then
    command -v sdlc
    return 0
  fi
  return 1
}

if binary="$(find_binary)"; then
  exec "${binary}" hook "${event}"
fi

# Read the payload to end of file so the caller never writes into a closed pipe.
while IFS= read -r _payload_line; do :; done || true

printf '{"continue":true}\n'

printf '%s\n' \
  'sdlc: the sdlc binary was not found, so nothing is being enforced.' \
  '' \
  '  why  the plugin is installed, but the binary it drives is not on PATH and' \
  '       is not in the bin directory of the plugin' \
  '  fix  run "sdlc doctor" in your terminal; if that also fails, reinstall' \
  '       with "npx @bbsnly/sdlc install"' >&2
exit 0
