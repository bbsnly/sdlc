#!/bin/sh
# Hand a hook event to the sdlc binary, wherever it happens to live.
#
# This runs on every matching tool call, so it does as little as possible and
# never blocks the session on its own failure: if the binary cannot be found,
# the tool call is allowed and the reason goes back as a system message, which
# the session shows. Enforcement silently off would be worse than enforcement
# off with an explanation.
#
# The fallback path uses only shell builtins. An environment that has lost the
# sdlc binary may have lost more, and the failure path is the last place that
# should need something else to be installed.
set -eu

event="${1:-}"

# -x alone is true of a directory, and exec'ing one ends this script with no
# reply at all. An SDLC_BIN that names nothing runnable is passed over quietly,
# because this is the hot path; "sdlc doctor" is what reports it.
find_binary() {
  if [ -n "${SDLC_BIN:-}" ] && [ -f "${SDLC_BIN}" ] && [ -x "${SDLC_BIN}" ]; then
    printf '%s' "${SDLC_BIN}"
    return 0
  fi
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/bin/sdlc" ] && [ -x "${CLAUDE_PLUGIN_ROOT}/bin/sdlc" ]; then
    printf '%s' "${CLAUDE_PLUGIN_ROOT}/bin/sdlc"
    return 0
  fi
  if command -v sdlc >/dev/null 2>&1; then
    command -v sdlc
    return 0
  fi
  # Where the installers put it, found without PATH. A desktop app keeps the
  # PATH it started with, and on macOS one never has the shell's at all, so a
  # binary every new terminal found was not found here. PATH is looked at
  # first, so a binary somebody put elsewhere on purpose still wins.
  if [ -n "${HOME:-}" ] && [ -f "${HOME}/.local/bin/sdlc" ] && [ -x "${HOME}/.local/bin/sdlc" ]; then
    printf '%s' "${HOME}/.local/bin/sdlc"
    return 0
  fi
  if [ -n "${LOCALAPPDATA:-}" ]; then
    # Git Bash hands this over as Windows wrote it, with backslashes.
    case "${LOCALAPPDATA}" in
      *\\*) candidate="${LOCALAPPDATA}\\Programs\\sdlc\\bin\\sdlc.exe" ;;
      *) candidate="${LOCALAPPDATA}/Programs/sdlc/bin/sdlc.exe" ;;
    esac
    if [ -f "${candidate}" ] && [ -x "${candidate}" ]; then
      printf '%s' "${candidate}"
      return 0
    fi
  fi
  return 1
}

# takes_part reports whether a directory, or one above it in the same
# repository, has .sdlc/config.json. The walk stops at a repository boundary,
# as the binary's does, so a project never inherits the configuration of one
# further up.
#
# It is a narrower rule than the binary's. The binary also looks from the file
# a call writes and from every path a command names, so a session opened above
# a project that uses sdlc is enforced there; without the binary, that session
# hears nothing, because reading paths out of the payload is no job for shell
# builtins. Git Bash on Windows can hand this a project directory written with
# backslashes, so a name with no slash in it goes up by its backslashes.
takes_part() {
  dir="$1"
  while [ -n "${dir}" ]; do
    # Never "//": Git Bash reads a path that starts with two slashes as a
    # network share, and would go looking for a host called .sdlc.
    case "${dir}" in
      */ | *\\) base="${dir}" ;;
      *) base="${dir}/" ;;
    esac
    if [ -e "${base}.sdlc/config.json" ]; then
      return 0
    fi
    if [ -e "${base}.git" ] || [ "${dir}" = / ]; then
      return 1
    fi
    case "${dir}" in
      */*)
        dir="${dir%/*}"
        if [ -z "${dir}" ]; then dir=/; fi
        ;;
      *\\*) dir="${dir%\\*}" ;;
      *) return 1 ;;
    esac
  done
  return 1
}

if binary="$(find_binary)"; then
  exec "${binary}" hook "${event}"
fi

# Read the payload to end of file so the caller never writes into a closed pipe.
while IFS= read -r _payload_line; do :; done || true

# The plugin is installed for every session, and most sessions are in projects
# that do not use sdlc. Each of them was told, on every tool call, that nothing
# was being enforced -- in a project with nothing to enforce. Now only a
# session whose project directory or working directory is in a project that
# uses sdlc hears it; takes_part says where that is narrower than the binary.
if ! takes_part "${CLAUDE_PROJECT_DIR:-}" && ! takes_part "${PWD:-}"; then
  exit 0
fi

# systemMessage is what reaches the session. Stderr from a hook that exits 0
# goes to Claude Code's debug log only, so the lines below it are for that log;
# on their own they told nobody that enforcement was off.
printf '%s\n' '{"continue":true,"systemMessage":"sdlc: the sdlc binary was not found, so nothing is being enforced. why: it is not at SDLC_BIN, in the bin directory of the plugin, on the PATH this app started with, or where the installers put it. fix: install it with npx @bbsnly/sdlc install. A desktop app such as Claude Desktop keeps the PATH it started with, so quit it fully and reopen it after installing or changing PATH, or set SDLC_BIN to the full path of the binary. Then run sdlc doctor in your terminal."}'

printf '%s\n' \
  'sdlc: the sdlc binary was not found, so nothing is being enforced.' \
  '' \
  '  why  it is not at SDLC_BIN, in the bin directory of the plugin, on the PATH' \
  '       this app started with, or where the installers put it' \
  '  fix  install it with "npx @bbsnly/sdlc install". A desktop app such as' \
  '       Claude Desktop keeps the PATH it started with, so quit it fully and' \
  '       reopen it after installing or changing PATH, or set SDLC_BIN to the' \
  '       full path of the binary. Then run "sdlc doctor" in your terminal.' >&2
exit 0
