# Build output
/dist/
/bin/sdlc
/bin/sdlc.exe

# Where the plugin's launcher stages the download it fetches on the first
# session, when a developer loads the plugin from this checkout without
# SDLC_BIN. The binary it fetches is ignored further down.
/plugin/bin/.sdlc-fetch.*

# `go build ./internal/tools/<name>` drops the executable in the working
# directory under that name. Ignored here, and the hygiene check refuses to
# track a compiled binary under any name, because this is easy to sweep into a
# commit with `git add -A` and hard to notice afterwards.
/linkcheck
/release

# Internal working documents. Never committed: this repository carries the
# product and what a user needs to understand it, and nothing else.
/plan/

# The loop's own story prose, when sdlc runs on itself. The machine state the
# gates need (tests.lock, gate-record.json, story.json) stays tracked; the
# model-written prose does not. This is a rule about THIS repository -- sdlc
# writes no opinion about what your project should commit.
/.sdlc/stories/

# The backlog, when sdlc runs on itself. Ignored for now: the stories here are
# this repository's own to-do list, still being shaped, and not something a
# user of sdlc needs. Again a rule about THIS repository -- sdlc itself expects
# a project to commit its backlog, and docs/getting-started.md says so.
/user_stories.json

# .sdlc/state holds one load-bearing file, and the rest are not: tests.lock is
# the freeze itself and belongs in history, while `active` and `session` are
# which story this machine happens to be on and which session is working it,
# `acknowledged` is how far the person using this clone has read the log, and
# cover.out is a build artefact.
/.sdlc/state/

# Where `./task markdownlint` installs markdownlint from its lockfile.
node_modules/

# Scratch paths the launcher and tests use
/.scratch/
*.tmp

# OS and editor noise
.DS_Store
Thumbs.db

# The binary the plugin launcher finds if it is there, and fetches if it is
# not. Never committed: the plugin ships from a release archive, not from the
# repository, and `./task build` puts the binary in dist/ instead.
/plugin/bin/sdlc
/plugin/bin/sdlc.exe

# Built at release time, never committed: the checksums belong to a release
# that does not exist yet when the repository is at rest.
/npm/checksums.txt
/npm/LICENSE
/npm/*.tgz
