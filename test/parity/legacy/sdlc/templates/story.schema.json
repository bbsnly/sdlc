{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLC loop backlog",
  "type": "object",
  "required": ["stories"],
  "properties": {
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "acceptance_criteria"],
        "properties": {
          "id":       { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+(\\.[0-9]+)*$" },
          "title":    { "type": "string" },
          "as_a":     { "type": "string" },
          "i_want":   { "type": "string" },
          "so_that":  { "type": "string" },
          "priority": { "type": "integer", "minimum": 0, "description": "0 = fix-forward/urgent, 1 = highest normal" },
          "status":   { "type": "string", "enum": ["todo", "ready", "in_progress", "awaiting_human", "blocked", "done", "dropped"] },
          "risk_tier":{ "type": "string", "enum": ["low", "medium", "high"] },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": {
            "type": "array", "minItems": 1,
            "items": { "type": "object", "required": ["id", "text"],
              "properties": { "id": { "type": "string", "pattern": "^AC-[0-9]+$" }, "text": { "type": "string", "description": "EARS form: WHEN/WHILE/IF-THEN/WHERE/ubiquitous" }, "type": { "type": "string" } } }
          },
          "non_goals": { "type": "array", "items": { "type": "string" } },
          "decisions": { "type": "array", "items": { "type": "object", "properties": { "at": {"type":"string"}, "by": {"type":"string"}, "text": {"type":"string"} } } },
          "notes":    { "type": "string" },
          "created":  { "type": "string" },
          "updated":  { "type": "string" }
        }
      }
    }
  }
}
