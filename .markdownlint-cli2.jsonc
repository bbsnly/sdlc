{
  // Documentation conventions for this repository. Each disabled rule is
  // disabled for a reason, stated here, rather than because it was noisy.
  "config": {
    "default": true,

    // Prose wraps at 80 by hand. Tables and code blocks cannot always, and
    // reflowing a table to fit is worse for the reader than a long line.
    "MD013": {
      "line_length": 100,
      "tables": false,
      "code_blocks": false,
      "headings": false
    },

    // A `$` prefix marks the line the reader types, which matters here because
    // some blocks show output and some do not, and CI runs a subset of them.
    // The convention is load-bearing; the rule would forbid it.
    "MD014": false,

    // Bare URLs are fine in prose where the URL is the thing being named.
    "MD034": false
  },
  "globs": ["**/*.md"],

  // internal/scaffold/templates holds fragments that are written into a user's
  // own files. They are program data, not documentation of this repository, and
  // a fragment that starts at a `##` heading is not a document with a missing
  // title. Their shape is asserted by the scaffold's tests instead.
  // The pull request template is a fragment written into a text box, not a
  // document: a heading above the first section would render as a title
  // inside every PR body.
  "ignores": [
    ".github/PULL_REQUEST_TEMPLATE.md",
    "plan/**",
    "test/parity/legacy/**",
    "internal/scaffold/templates/**",
    "node_modules/**"
  ]
}
